# AI Proxy inbound client credentials. The matching
# `auth "main" { client "ci" { token = env("AIPROXY_CLIENT_CI_TOKEN") } }`
# block must be configured in the aiproxy config file.
AIPROXY_CLIENT_CI_TOKEN=change-me

# Upstream provider API keys. Reference these from the HCL config with
# `api_key = env("OPENAI_API_KEY")`, etc.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
