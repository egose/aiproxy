AIPROXY_DATABASE_URL=postgres://postgres:postgres@localhost:55432/aiproxy?sslmode=disable # pragma: allowlist secret
AIPROXY_JWT_SECRET=dev-only-jwt-secret-change-me
AIPROXY_ADMIN_EMAIL=admin@example.com
AIPROXY_ADMIN_PASSWORD=admin-password-change-me
# Static example client token and upstream key (dev-only placeholders).
# Any non-empty value passes validation; no upstream call happens until a request.
AIPROXY_CLIENT_CI_TOKEN=dev-only-ci-token-change-me
OPENAI_API_KEY=dev-only-openai-key-change-me
