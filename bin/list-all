#!/usr/bin/env bash
set -euo pipefail

github_coordinates="${ASDF_AIPROXY_GITHUB_REPOSITORY:-egose/aiproxy}"
releases_url="https://api.github.com/repos/${github_coordinates}/releases"

curl_opts=("-fsSL" "--connect-timeout" "10" "--retry" "3" "-H" "Accept: application/vnd.github+json" "-H" "X-GitHub-Api-Version: 2022-11-28")
if [ -n "${GITHUB_API_TOKEN:-}" ]; then
  curl_opts+=("-H" "Authorization: Bearer $GITHUB_API_TOKEN")
fi

all_tags=""
page=1
while :; do
  current_url="${releases_url}?per_page=100&page=${page}"
  response=$(curl "${curl_opts[@]}" "$current_url")
  compact=$(printf '%s' "$response" | tr -d '[:space:]')
  case "$compact" in
    \[*\]) ;;
    *) echo "GitHub releases API returned an unexpected response." >&2; exit 1 ;;
  esac
  tags=$(printf '%s\n' "$response" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p')
  if [ -z "$tags" ]; then
    break
  fi
  all_tags="${all_tags}${tags}"$'\n'
  count=$(printf '%s\n' "$tags" | awk 'NF { count++ } END { print count + 0 }')
  [ "$count" -eq 100 ] || break
  page=$((page + 1))
done

versions=$(printf '%s' "$all_tags" |
  awk '/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$/ { print }' |
  LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n |
  awk 'BEGIN { first=1 } { if (!first) printf " "; printf "%s", $0; first=0 } END { print "" }')

printf '%s' "$versions"
