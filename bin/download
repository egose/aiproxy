#!/usr/bin/env bash
set -euo pipefail

tool_name="aiproxy"

github_coordinates="${ASDF_AIPROXY_GITHUB_REPOSITORY:-egose/aiproxy}"
base_download_url="https://github.com/${github_coordinates}/releases/download"

version="$ASDF_INSTALL_VERSION"
download_path="$ASDF_DOWNLOAD_PATH"

case "$(uname -s)" in
  Darwin) os="darwin" ;;
  Linux)  os="linux"  ;;
  FreeBSD) os="freebsd" ;;
  OpenBSD) os="openbsd" ;;
  NetBSD)  os="netbsd"  ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  x86_64|amd64) arch="amd64" ;;
  arm64|aarch64) arch="arm64" ;;
  i386|i686) arch="386" ;;
  armv7l|arm) arch="arm" ;;
  *) echo "Unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac

case "${os}:${arch}" in
  linux:amd64|linux:arm64|linux:386|linux:arm|windows:amd64|windows:386|darwin:amd64|darwin:arm64|freebsd:amd64|freebsd:arm64|openbsd:amd64|openbsd:arm64|netbsd:amd64) ;;
  *) echo "Unsupported platform: ${os}:${arch}" >&2; exit 1 ;;
esac

filename="${tool_name}-${os}-${arch}.tar.gz"
checksums_filename="checksums.txt"

mkdir -p "$download_path"
download_url="${base_download_url}/v${version}/${filename}"
outfile="${download_path}/${filename}"
checksums_file="${download_path}/${checksums_filename}"

echo "Attempting to download: $download_url"

curl -fsSL --connect-timeout 10 --retry 3 "$download_url" -o "$outfile"
curl -fsSL --connect-timeout 10 --retry 3 \
  "${base_download_url}/v${version}/${checksums_filename}" -o "$checksums_file"

expected=$(awk -v name="$filename" '$2 == name || $2 == "*" name || $2 == "./" name { print $1 }' "$checksums_file")
if [[ ! $expected =~ ^[0-9a-fA-F]{64}$ ]]; then
  echo "Error: Expected exactly one SHA-256 checksum for ${filename}." >&2
  exit 1
fi
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$outfile")
else
  actual=$(shasum -a 256 "$outfile")
fi
actual=$(printf '%s' "${actual%% *}" | tr '[:upper:]' '[:lower:]')
expected=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
if [ "$actual" != "$expected" ]; then
  echo "Error: Checksum verification failed for ${filename}." >&2
  exit 1
fi

echo "Download and checksum verification successful."
