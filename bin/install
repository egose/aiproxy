#!/usr/bin/env bash
set -euo pipefail

tool_name="aiproxy"
install_type="$ASDF_INSTALL_TYPE"
version="$ASDF_INSTALL_VERSION"
install_path="$ASDF_INSTALL_PATH"
download_path="$ASDF_DOWNLOAD_PATH"

if [ "$install_type" != "version" ]; then
  echo "asdf-$tool_name supports install type 'version' only (got: $install_type)" >&2
  exit 1
fi

(
  shopt -s nullglob
  archives=("$download_path"/*.tar.gz)

  echo "Installing $tool_name v$version..."

  if [ "${#archives[@]}" -ne 1 ]; then
    echo "Expected exactly one release archive in $download_path, found ${#archives[@]}." >&2
    exit 1
  fi

  case "${archives[0]}" in
    *-windows-*) expected="${tool_name}.exe" ;;
    *) expected="$tool_name" ;;
  esac
  members=$(tar -tzf "${archives[0]}")
  if [ "$members" != "$expected" ]; then
    echo "Release archive must contain exactly one top-level $expected executable." >&2
    exit 1
  fi
  details=$(tar -tvzf "${archives[0]}")
  case "$details" in
    -*) ;;
    *) echo "Release archive member must be a regular file." >&2; exit 1 ;;
  esac

  parent=${install_path%/*}
  [ "$parent" != "$install_path" ] || parent=.
  mkdir -p "$parent"
  stage=$(mktemp -d "$parent/.${tool_name}.install.XXXXXX")
  trap 'rm -rf "$stage"' EXIT
  mkdir "$stage/bin"
  tar --no-same-owner --no-same-permissions -xzf "${archives[0]}" -C "$stage/bin"
  if [ ! -f "$stage/bin/$expected" ] || [ -L "$stage/bin/$expected" ]; then
    echo "Release archive does not contain one regular $expected executable." >&2
    exit 1
  fi
  chmod 0755 "$stage/bin/$expected"
  if [ -d "$install_path" ]; then
    rmdir "$install_path" || { echo "Install path already exists and is not empty: $install_path" >&2; exit 1; }
  elif [ -e "$install_path" ]; then
    echo "Install path already exists: $install_path" >&2
    exit 1
  fi
  mv "$stage" "$install_path"
  trap - EXIT

  echo "$tool_name v$version installation was successful!"
) || {
  echo "Error: Installation failed." >&2
  exit 1
}
